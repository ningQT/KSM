# KSM Environment Variables
# Copy this file to .env and fill in values
#
# To switch environment:
#   KSM_ENV=test  → loads .env.test
#   KSM_ENV=prod  → loads .env.prod
#   (unset)       → loads .env


# === Docker Deployment ===
# These variables are consumed by docker-compose.yml.
KSM_ENV=prod
KSM_PUBLIC_SCHEME=http
KSM_PUBLIC_HOST=localhost
KSM_FRONTEND_PORT=8080
KSM_ENABLE_DOCS=false
KSM_SECURE_COOKIES=false
KSM_TRUST_PROXY_HEADERS=true
KSM_REQUIRE_HTTPS_LLM_BASE_URL=false
KSM_LLM_SSRF_PROTECTION=true

# === Data Paths ===
KSM_DATA_DIR=./data/vaults
KSM_TEMPLATE_DIR=./templates
# KSM_CONFIG_DIR=./configs

# === Local Runtime HTTP API ===
# These values are used when running the backend directly from the source tree.
KSM_HOST=127.0.0.1
KSM_PORT=8900
KSM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KSM_MAX_UPLOAD_BYTES=10485760
KSM_ENABLE_CSRF_PROTECTION=true
KSM_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KSM_RATE_LIMIT_ENABLED=true
KSM_RATE_LIMIT_WINDOW_SECONDS=60
KSM_RATE_LIMIT_AUTH_PER_WINDOW=10
KSM_RATE_LIMIT_DEFAULT_PER_WINDOW=120
KSM_RATE_LIMIT_WRITE_PER_WINDOW=30
KSM_RATE_LIMIT_HEAVY_PER_WINDOW=10
KSM_SSE_TOKEN_TTL_SECONDS=60
KSM_EXPOSE_ERROR_DETAILS=false
KSM_DB_BACKUP_DIR=./data/backups
KSM_BACKUP_BEFORE_MIGRATION=true

# === Logging ===
KSM_LOG_LEVEL=INFO

# === Git Sync (optional) ===
# KSM_GIT_REPO_DIR=
# KSM_GIT_WEBHOOK_SECRET=

# === Semantic Deduplication - Embedding Configuration ===
# Embedding provider (openai, anthropic, etc.)
# Embedding API base URL (leave empty to fall back to KSM_LLM_BASE_URL)
# Embedding API key (leave empty to fall back to KSM_LLM_API_KEY)
# Embedding model name
# Embedding vector dimension
# Batch size for embedding requests

# === Semantic Deduplication - Thresholds ===
# Source-level deduplication threshold (0.0-1.0, higher = stricter)
KSM_DEDUP_SOURCE_THRESHOLD=0.92
# Card-level deduplication threshold (0.0-1.0, higher = stricter)
KSM_DEDUP_CARD_THRESHOLD=0.88
# Merge deduplication threshold (0.0-1.0, higher = stricter)
KSM_DEDUP_MERGE_THRESHOLD=0.90
